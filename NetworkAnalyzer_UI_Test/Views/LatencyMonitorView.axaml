<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:NetworkAnalyzer_UI_Test.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="NetworkAnalyzer_UI_Test.Views.LatencyMonitorView"
    x:DataType="vm:LatencyMonitorViewModel"
    FontSize="16">
    
    <Grid RowDefinitions="70,190,.8*,*" ColumnDefinitions="1.2*,*">
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="ProfilePropertiesCard">
            <Grid RowDefinitions="30,45,10,30,45,*,50" ColumnDefinitions="*,50">
                <Label Grid.Row="0" Grid.Column="0" Content="Preset Name"/>
                
                <TextBox Grid.Row="1" Grid.Column="0" PlaceholderText="Enter a name for the preset"/>
                
                <Label Grid.Row="3" Grid.Column="0" Content="Target Address to Add"/>
                
                <TextBox Grid.Row="4" Grid.Column="0" PlaceholderText="Enter an address to monitor"/>
                
                <Button Grid.Row="4" Grid.Column="1">
                    <mi:MaterialIconExt Kind="PlusBoxOutline" IconSize="28"/>
                </Button>
                
                <ListBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"/>
                
                <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
                    <Button Content="Save" DockPanel.Dock="Left" Classes="PrimaryButton"/>
                    <Button Content="Cancel" DockPanel.Dock="Right" Classes="SecondaryButton"/>
                </DockPanel>
            </Grid>
        </Border>
        
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="ContentCard">
            <DockPanel>
                <Button DockPanel.Dock="Left" Width="80" Classes="PrimaryButton">
                    <Label Content="Start"/>
                </Button>
            
                <Button DockPanel.Dock="Left" Width="80" Classes="PrimaryButton">
                    <Label Content="Stop"/>
                </Button>
                
                <ComboBox DockPanel.Dock="Right" Classes="ProfileDropdown"/>
                
                <Button DockPanel.Dock="Right" Width="50" Classes="SecondaryButton">
                    <mi:MaterialIconExt Kind="NoteRemoveOutline" IconSize="30"/>
                </Button>
                
                <Button DockPanel.Dock="Right" Width="50" Classes="SecondaryButton">
                    <mi:MaterialIconExt Kind="NoteEditOutline" IconSize="30"/>
                </Button>
                
                <Button DockPanel.Dock="Right" Width="50" Classes="SecondaryButton">
                    <mi:MaterialIconExt Kind="NotePlusOutline" IconSize="30"/>
                </Button>
            </DockPanel>
        </Border>
        
        <Border Grid.Row="1" Grid.Column="0" Classes="ContentCard">
            <Border Classes="ContentCardTitle">
                <Label Content="Overview"/>
            </Border>
        </Border>
        
        <Border Grid.Row="2" Grid.Column="0" Classes="ContentCard">
            <Border Classes="ContentCardTitle">
                <Label Content="User Defined Targets (Live)"/>
            </Border>
        </Border>
        
        <Border Grid.Row="3" Grid.Column="0" Classes="ContentCard">
            <Border Classes="ContentCardTitle">
                <Label Content="Target History"/>
            </Border>
        </Border>
        
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Classes="ContentCard">
            <Border Classes="ContentCardTitle">
                <Label Content="Traceroute Targets (Live)"/>
            </Border>
        </Border>
    </Grid>
</UserControl>
