<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:NetworkAnalyzer.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="NetworkAnalyzer.Views.IPScannerView"
    x:DataType="vm:IPScannerViewModel"
    FontSize="16">
    
    <Grid RowDefinitions="70,*,Auto" ColumnDefinitions="*,4,250">
        <!--Options Card-->
        <Border Grid.Row="0" Grid.Column="2" Classes="OptionsCard">
            <Grid RowDefinitions="30,40,40,30,40,40,40,35">
                <Label Grid.Row="0" Content="Scan Type"/>
                <RadioButton Grid.Row="1" GroupName="ScanType" IsChecked="{Binding IsAutoChecked}">
                    <Label Content="Auto"/>
                </RadioButton>
                <RadioButton Grid.Row="2" GroupName="ScanType" IsChecked="{Binding IsManualChecked}">
                    <Label Content="Manual"/>
                    <ToolTip.Tip>
                        <ToolTip ShowDelay="0">
                            <TextBlock FontSize="16">
                                <Bold>Allowed Manual Scan Formats:</Bold><LineBreak/>
                                172.30.1.1/24 (IP followed by CIDR Notation)<LineBreak/>
                                172.30.1.1 255.255.255.0 (IP followed by Subnet Mask)<LineBreak/>
                                172.30.1.1 - 172.30.1.5 (IP range separated by a hyphen)
                            </TextBlock>
                        </ToolTip>
                    </ToolTip.Tip>
                </RadioButton>
                
                <Label Grid.Row="3" Content="Port Selection"/>
                <RadioButton Grid.Row="4" GroupName="PortSelection" IsChecked="{Binding IsCommonScanChecked}">
                    <Label Content="Common"/>
                    <ToolTip.Tip>
                        <ToolTip ShowDelay="0">
                            <TextBlock FontSize="16">
                                Scans a list of commonly used ports:<LineBreak/>
                                21, 22, 23, 25, 69, 80, 115, 156, 443, 445, 547, 3389
                            </TextBlock>
                        </ToolTip>
                    </ToolTip.Tip>
                </RadioButton>
                <RadioButton Grid.Row="5" GroupName="PortSelection" IsChecked="{Binding IsFullScanChecked}">
                    <Label Content="All"/>
                    <ToolTip.Tip>
                        <ToolTip ShowDelay="0">
                            <TextBlock FontSize="16">
                                Scans all ports, including ephemeral ports, between 1 and 65,535.
                            </TextBlock>
                        </ToolTip>
                    </ToolTip.Tip>
                </RadioButton>
                <RadioButton Grid.Row="6" GroupName="PortSelection" IsChecked="{Binding IsCustomScanChecked}">
                    <Label Content="Custom"/>
                    <ToolTip.Tip>
                        <ToolTip ShowDelay="0">
                            <TextBlock FontSize="16">
                                Enter ports to scan in the field below, separated with a comma.<LineBreak/>
                                Example: 12, 54, 776 (spaces are ok)
                            </TextBlock>
                        </ToolTip>
                    </ToolTip.Tip>
                </RadioButton>
                <TextBox 
                    Grid.Row="7" 
                    Width="148" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Text="{Binding CustomPortCollection}"
                    IsEnabled="{Binding IsCustomScanChecked}"/>
            </Grid>
        </Border>
        
        <!--Top Controls Bar-->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Classes="ContentCard">
            <Grid ColumnDefinitions="90,90,10,*,10,130">
                <Button
                    Grid.Column="0"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Left"
                    Width="80"
                    IsEnabled="{Binding IsStartButtonEnabled}"
                    Command="{Binding StartIPScanButtonCommand}"
                    Classes="PrimaryButton">
                    <Label Content="Start"/>
                </Button>
                
                <Button
                    Grid.Column="1"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Left"
                    Width="80"
                    IsEnabled="{Binding IsStopButtonEnabled}"
                    Command="{Binding StopIPScanButtonCommand}"
                    Classes="PrimaryButton">
                    <Label Content="Stop"/>
                </Button>

                <Border
                    Grid.Column="2"
                    HorizontalAlignment="Left"/>

                <TextBox
                    Grid.Column="3"
                    MinWidth="200"
                    HorizontalAlignment="Stretch"
                    IsFocused="{Binding IsControlFocused, Mode=TwoWay}"
                    IsReadOnly="{Binding IsAutoChecked}"
                    Text="{Binding SubnetsToScan}"> 
                    <TextBox.Styles>
                        <Style Selector="TextBox">
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="PlaceholderText" Value="{Binding SubnetsToScanPlaceholderText}"/>
                        </Style>
                    </TextBox.Styles>
                </TextBox>

                <Border
                    Grid.Column="4"
                    HorizontalAlignment="Right"/>
                
                <ToggleButton 
                    Grid.Column="5" 
                    HorizontalAlignment="Right"
                    Margin="5,0,5,0"
                    Width="120"
                    IsChecked="{Binding IsOptionsButtonChecked}"
                    Classes="SecondaryToggleButton">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Options  |"/>
                        <mi:MaterialIcon Kind="{Binding OptionsIcon}" IconSize="26"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>
        
        <!--Scan Results-->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="{Binding DataGridRowSpan}" Classes="ContentCard">
            <Grid RowDefinitions="35,*">
                <Border Grid.Row="0" Classes="ContentCardTitle">
                    <Label Content="Scan Results"/>
                </Border>
                
                <DataGrid
                    Grid.Row="1"
                    ItemsSource="{Binding AllScanResults}"
                    SelectedItem="{Binding SelectedScanResult}"
                    Background="{DynamicResource SystemAltLowColor}"
                    GridLinesVisibility="Horizontal"
                    IsReadOnly="True"
                    IsFocused="{Binding IsControlFocused, Mode=TwoWay}"
                    SelectionMode="Extended"
                    VerticalScrollBarVisibility="Auto"
                    CanUserResizeColumns="True"
                    BorderThickness="0">
                    
                    <DataGrid.Styles>
                        <Style Selector="DataGridColumnHeader">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="{DynamicResource SystemAltLowColor}"/>
                            <Setter Property="AreSeparatorsVisible" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                                
                        <Style Selector="DataGridCell">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        
                        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                        
                        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                    </DataGrid.Styles>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="1.3*"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="MAC Address" Binding="{Binding MACAddress}" Width="1.5*"/>
                        <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
        <GridSplitter 
            Grid.Row="1" 
            Grid.Column="1" 
            IsVisible="{Binding IsDetailsPaneVisible}" 
            Classes="ColumnSplitter"/>
        
        <!--Details Pane-->
        <Border Grid.Row="1" Grid.Column="2" Classes="DetailsPane" Classes.IsExpanded="{Binding IsDetailsPaneVisible}">
            <ScrollViewer>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <Label Grid.Row="0" Content="IP Address" Classes="OverviewHeaders"/>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedScanResult.IPAddress}" Classes="DataDisplay"/>
                
                    <Label Grid.Row="2" Content="Name" Classes="OverviewHeaders"/>
                    <TextBlock Grid.Row="3" Text="{Binding SelectedScanResult.Name}" Classes="DataDisplay"/>
                
                    <Label Grid.Row="4" Content="MAC Address" Classes="OverviewHeaders"/>
                    <TextBlock Grid.Row="5" Text="{Binding SelectedScanResult.MACAddress}" Classes="DataDisplay"/>
                
                    <Label Grid.Row="6" Content="Manufacturer" Classes="OverviewHeaders"/>
                    <TextBlock Grid.Row="7" Text="{Binding SelectedScanResult.Manufacturer}" Classes="DataDisplay"/>
                
                    <Label Grid.Row="8" Content="Latency" Classes="OverviewHeaders"/>
                    <TextBlock Grid.Row="9" Text="{Binding SelectedScanResult.DisplayLatency}" Classes="DataDisplay"/>
                
                    <Label Grid.Row="10" Content="Available Actions" Classes="OverviewHeaders"/>
                    <ListBox Grid.Row="11" ItemsSource="{Binding SelectedScanResult.ActiveServices}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem:current /template/ Rectangle#CurrencyVisual">
                                <Setter Property="IsVisible" Value="False"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,55">
                                    <Label Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{Binding ServiceName}"/>
                                    <Button Grid.Column="1" Width="35" Height="30" HorizontalAlignment="Right" Command="{Binding LaunchServiceSessionAsync}" Classes="SecondaryButton">
                                        <mi:MaterialIconExt Kind="OpenInNew" IconSize="25"/>
                                        <ToolTip.Tip>
                                            <ToolTip ShowDelay="0">
                                                <TextBlock>
                                                    Launch window for
                                                    <Label Content="{Binding ServiceName}"/>
                                                </TextBlock>
                                            </ToolTip>
                                        </ToolTip.Tip>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <Label Grid.Row="12" Content="Active Ports" Classes="OverviewHeaders"/>
                    <ListBox Grid.Row="13" IsHitTestVisible="False" ItemsSource="{Binding SelectedScanResult.ActivePorts}"/>
                </Grid>
            </ScrollViewer>
        </Border>
        
        <!--Bottom Status Bar-->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Classes="ContentCard">
            <Grid ColumnDefinitions="1.2*,20,*,20,*,20,*,20,1.1*">
                <!--Current Session Status-->
                <DockPanel Grid.Column="0" Classes="ScanStatus">

                    <Label DockPanel.Dock="Left">
                        <mi:MaterialIcon Kind="Radar" IconSize="24"/>
                        <ToolTip.Tip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" Text="Current Session Status"/>
                            </ToolTip>
                        </ToolTip.Tip>
                    </Label>

                    <TextBlock
                        Text="{Binding ScanStatus}"
                        DockPanel.Dock="Right"/>
                </DockPanel>

                <Border Grid.Column="1" Classes="VerticalMenuDivider"/>

                <!--Total Available Devices-->
                <DockPanel Grid.Column="2" Classes="ScanStatus">

                    <Label DockPanel.Dock="Left">
                        <mi:MaterialIcon Kind="Lan" IconSize="24"/>
                        <ToolTip.Tip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" Text="Total IP Addresses in Scannable Subnets"/>
                            </ToolTip>
                        </ToolTip.Tip>
                    </Label>

                    <TextBlock
                        Text="{Binding TotalAddressCount}"
                        DockPanel.Dock="Right"/>
                </DockPanel>

                <Border Grid.Column="3" Classes="VerticalMenuDivider"/>

                <!--Total Devices Online-->
                <DockPanel Grid.Column="4" Classes="ScanStatus">

                    <Label
                        Foreground="Green"
                        DockPanel.Dock="Left">
                        <mi:MaterialIcon Kind="NetworkOutline" IconSize="24"/>
                        <ToolTip.Tip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" Text="Active IP Addresses"/>
                            </ToolTip>
                        </ToolTip.Tip>
                    </Label>

                    <TextBlock
                        Text="{Binding TotalActiveAddresses}"
                        DockPanel.Dock="Right"/>
                </DockPanel>

                <Border Grid.Column="5" Classes="VerticalMenuDivider"/>

                <!--Total Devices Offline-->
                <DockPanel Grid.Column="6" Classes="ScanStatus">

                    <Label
                        Foreground="Red"
                        DockPanel.Dock="Left">
                        <mi:MaterialIcon Kind="NetworkOffOutline" IconSize="24"/>
                        <ToolTip.Tip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" Text="Inactive IP Addresses"/>
                            </ToolTip>
                        </ToolTip.Tip>
                    </Label>

                    <TextBlock
                        Text="{Binding TotalInactiveAddresses}"
                        DockPanel.Dock="Right"/>
                </DockPanel>

                <Border Grid.Column="7" Classes="VerticalMenuDivider"/>

                <!--Scan Duration-->
                <DockPanel Grid.Column="8" Classes="ScanStatus">

                    <Label DockPanel.Dock="Left">
                        <mi:MaterialIcon Kind="TimerOutline" IconSize="24"/>
                        <ToolTip.Tip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" Text="Scan Duration"/>
                            </ToolTip>
                        </ToolTip.Tip>
                    </Label>

                    <TextBlock
                        Text="{Binding ScanDuration}"
                        DockPanel.Dock="Right"
                        Margin="0,0,10,0"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
