<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:NetworkAnalyzer.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="NetworkAnalyzer.Views.LatencyMonitorHistoryView"
    x:DataType="vm:LatencyMonitorHistoryViewModel"
    FontSize="16">
    
    <Grid RowDefinitions="70,*">
        <!--Load Report Card-->
        <Border Grid.Row="1" ZIndex="10" Classes="LoadReportsCard">
            <Grid RowDefinitions="*,Auto">
                <ListBox 
                    Grid.Row="0" 
                    ItemsSource="{Binding AvailableSessions}" 
                    SelectedItem="{Binding SelectedSession}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                <Label 
                                    Grid.Row="0" 
                                    Grid.Column="0" 
                                    Grid.ColumnSpan="2" 
                                    Content="{Binding DisplayName}"
                                    HorizontalAlignment="Left"/>
                                <Label 
                                    Grid.Row="1" 
                                    Grid.Column="0" 
                                    Content="{Binding StartTime}" 
                                    FontSize="12" 
                                    HorizontalAlignment="Left"/>
                                <Label 
                                    Grid.Row="1" 
                                    Grid.Column="1" 
                                    Content="{Binding TotalDuration}" 
                                    FontSize="12" 
                                    HorizontalAlignment="Left"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="100" Command="{Binding LoadSessionCommand}" Classes="PrimaryButton">
                        <Label Content="Select"/>
                    </Button>
                    <Button Width="100" Command="{Binding HideLoadReportsWindowCommand}" Classes="SecondaryButton">
                        <Label Content="Cancel"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!--Top Control Bar-->
        <Border Grid.Row="0" Classes="ContentCard">
            <Grid ColumnDefinitions="90,90,*,60,60">
                <Button Grid.Column="0" Width="80" Command="{Binding ShowLoadReportsWindowCommand}" Classes="PrimaryButton">
                    <Label Content="Load"/>
                </Button>
            
                <Button Grid.Column="1" Width="80" Classes="PrimaryButton">
                    <Label Content="Reset"/>
                </Button>
                
                <Button Grid.Column="3" Width="50" Classes="SecondaryButton">
                    <mi:MaterialIconExt Kind="FormatColumns" IconSize="30"/>
                    <ToolTip.Tip>
                        <ToolTip ShowDelay="0">
                            <Label Content="Select Active Columns"/>
                        </ToolTip>
                    </ToolTip.Tip>
                </Button>
                
                <Button Grid.Column="4" Width="50" Classes="SecondaryButton">
                    <mi:MaterialIconExt Kind="Refresh" IconSize="30"/>
                    <ToolTip.Tip>
                        <ToolTip ShowDelay="0">
                            <Label Content="Reload Current Data with Active Filters"/>
                        </ToolTip>
                    </ToolTip.Tip>
                </Button>
            </Grid>
        </Border>
        
        <!--Tab Control - History Viewer and Filter Options-->
        <Border Grid.Row="1" Classes="ContentCard">
            <TabControl>
                <!--History Viewer-->
                <TabItem Header="History Viewer" FontSize="18">
                    <Grid Margin="0,15,0,0">
                        <DataGrid
                            Background="{DynamicResource SystemAltLowColor}"
                            GridLinesVisibility="Horizontal"
                            IsReadOnly="True"
                            SelectionMode="Extended"
                            VerticalScrollBarVisibility="Auto"
                            CanUserResizeColumns="True"
                            BorderThickness="0"
                            ItemsSource="{Binding AllData}">
                        
                            <DataGrid.Styles>
                                <Style Selector="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="5,0,0,0"/>
                                    <Setter Property="Background" Value="{DynamicResource SystemAltLowColor}"/>
                                    <Setter Property="AreSeparatorsVisible" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            
                                <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                                    <Setter Property="IsVisible" Value="False"/>
                                </Style>
                            
                                <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                                    <Setter Property="IsVisible" Value="False"/>
                                </Style>
                            </DataGrid.Styles>
                        
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hop" Binding="{Binding Hop}" Width="45"/>
                                <DataGridTextColumn Header="Target Address" Binding="{Binding TargetAddress}" Width="*"/>
                                <DataGridTextColumn Header="Target Name" Binding="{Binding TargetName}" Width="*"/>
                                <DataGridTextColumn Header="Current" Binding="{Binding CurrentLatency}" Width="70"/>
                                <DataGridTextColumn Header="Low" Binding="{Binding LowestLatency}" Width="40"/>
                                <DataGridTextColumn Header="High" Binding="{Binding HighestLatency}" Width="40"/>
                                <DataGridTextColumn Header="Avg" Binding="{Binding AverageLatency}" Width="40"/>
                                <DataGridTextColumn Header="Failed" Binding="{Binding FailedPing}" Width="60"/>
                                <DataGridTextColumn Header="Total Lost" Binding="{Binding TotalPacketsLost}" Width="70"/>
                                <DataGridTextColumn Header="TimeStamp" Binding="{Binding TimeStamp}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                
                <!--Filter Options-->
                <TabItem Header="Filter Options" FontSize="18">
                    <Grid RowDefinitions="3*,*" ColumnDefinitions="375,*" Margin="0,15,0,0">
                        <Border Grid.Row="0" Grid.Column="0" Classes="ContentCard">
                            <StackPanel Orientation="Vertical">
                                <Border Classes="ContentCardTitle">
                                    <Label Content="Filter Options"/>
                                </Border>
                            
                                <!--Filter Type Combo Box-->
                                <ComboBox  
                                    ItemsSource="{Binding FilterTypes}"
                                    SelectedItem="{Binding SelectedFilterType}"
                                    PlaceholderText="Select a Filter"
                                    HorizontalAlignment="Stretch"
                                    Margin="3,10,3,10"/>
                                
                                <!--Filter Operator Combo Box-->
                                <ComboBox
                                    ItemsSource="{Binding FilterOperators}"
                                    SelectedItem="{Binding SelectedFilterOperator}"
                                    IsVisible="{Binding IsFilterOperatorComboBoxVisible}"
                                    PlaceholderText="Select an Operator"
                                    HorizontalAlignment="Stretch"
                                    Margin="3,10,3,10"/>
                                
                                <!--Binary Filter Operator Combo Box-->
                                <ComboBox
                                    ItemsSource="{Binding BinaryFilterOperators}"
                                    SelectedItem="{Binding SelectedBinaryFilterOperator}"
                                    IsVisible="{Binding IsBinaryFilterOperatorComboBoxVisible}"
                                    PlaceholderText="Select an Operator"
                                    HorizontalAlignment="Stretch"
                                    Margin="3,10,3,10"/>
                                
                                <!--Distinct Targets Combo Box-->
                                <ComboBox
                                    ItemsSource="{Binding DistinctTargets}"
                                    SelectedItem="{Binding SelectedDistinctTarget}"
                                    IsVisible="{Binding IsDistinctTargetsControlVisible}"
                                    HorizontalAlignment="Stretch"
                                    Margin="3,10,3,5"
                                    Padding="0">
                                    
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,Auto,*" Margin="10,0,0,0">
                                                <Label Grid.Row="0" Grid.Column="0" Content="User Defined Target" Classes="OverviewHeaders" MinWidth="145"/>
                                                <Label Grid.Row="1" Grid.Column="0" Content="{Binding UserDefinedTargetAddress}"/>
                                                <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Content="{mi:MaterialIconExt Kind=ArrowRightBoldOutline}" FontSize="25"/>
                                                <Label Grid.Row="0" Grid.Column="2" Content="Traceroute Target" Classes="OverviewHeaders"/>
                                                <Label Grid.Row="1" Grid.Column="2" Content="{Binding TracerouteTargetAddress}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <CheckBox
                                    Content="Use Traceroute Target"
                                    IsChecked="{Binding IsUseTracerouteTargetChecked}"
                                    IsVisible="{Binding IsDistinctTargetsControlVisible}"
                                    Margin="20,0,3,10"/>
                                
                                <!--String Value Textbox-->
                                <TextBox 
                                    Text="{Binding TextFilterValue}"
                                    IsVisible="{Binding IsTextFilterValueTextBoxVisible}"
                                    PlaceholderText="Enter a Value"
                                    HorizontalAlignment="Stretch"
                                    Margin="3,10,3,10"/>
                                
                                <!--Date Picker-->
                                <DatePicker
                                    SelectedDate="{Binding SelectedDate}"
                                    IsVisible="{Binding IsDateTimePickerVisible}"
                                    MonthFormat="MM"
                                    DayFormat="dd"
                                    YearFormat="yyyy"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Margin="3,10,3,10"/>
                                
                                <!--Time Picker-->
                                <TimePicker
                                    SelectedTime="{Binding SelectedTime}"
                                    IsVisible="{Binding IsDateTimePickerVisible}"
                                    ClockIdentifier="24HourClock"
                                    UseSeconds="True"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Margin="3,10,3,10"/>
                                
                                <!--Apply Filters Button-->
                                <Button
                                    Classes="PrimaryButton" 
                                    Width="140"
                                    HorizontalAlignment="Center"
                                    Margin="3,10,3,0"
                                    Command="{Binding ApplyFiltersCommand}">
                                    <Label Content="Apply Filter"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        
                        <DataGrid 
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            Background="{DynamicResource SystemAltLowColor}"
                            GridLinesVisibility="Horizontal"
                            SelectionMode="Extended"
                            VerticalScrollBarVisibility="Auto"
                            CanUserResizeColumns="True"
                            BorderThickness="0"
                            Margin="15,0,0,0"
                            ItemsSource="{Binding ActiveFilters}">
                            
                            <DataGrid.Styles>
                                <Style Selector="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="5,0,0,0"/>
                                    <Setter Property="Background" Value="{DynamicResource SystemAltLowColor}"/>
                                    <Setter Property="AreSeparatorsVisible" Value="False"/>
                                </Style>
                            
                                <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                                    <Setter Property="IsVisible" Value="False"/>
                                </Style>
                            
                                <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                                    <Setter Property="IsVisible" Value="False"/>
                                </Style>
                            </DataGrid.Styles>
                            
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Filter" Binding="{Binding DisplayType}" Width="*"/>
                                <DataGridTextColumn Header="Operator" Binding="{Binding DisplayOperator}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding FilterValue}" Width="*"/>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Command="{Binding ClearFilter}"
                                                CommandParameter="{Binding FilterGUID}">
                                                <mi:MaterialIcon Kind="TrashCanOutline" IconSize="25"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
