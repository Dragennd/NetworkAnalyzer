<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NetworkAnalyzer.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="NetworkAnalyzer.Views.ReportsView"
    x:DataType="vm:ReportsViewModel"
    FontSize="16">
    
    <Grid RowDefinitions="70,*">
        <!--Load Report Card-->
        <Border Grid.Row="1" Classes="NewReportCard">
            <Grid RowDefinitions="Auto,Auto,10,Auto,60">
                <Label Grid.Row="0" Content="Type" Classes="OverviewHeaders"/>
                <TextBlock Grid.Row="1" Margin="10,0,0,0" Text="{Binding SelectedSessionData.Mode}"/>
                
                <Grid 
                    Grid.Row="3" 
                    RowDefinitions="Auto,Auto,10,Auto,Auto,10,Auto" 
                    IsVisible="{Binding IsLatencyMonitorReportOptionsGridVisible}">
                    <Label Grid.Row="0" Content="Select User Defined Target" Classes="OverviewHeaders"/>
                    <ComboBox 
                        Grid.Row="1" 
                        DisplayMemberBinding="{Binding TargetAddress}"
                        ItemsSource="{Binding AvailableUserDefinedTargets}" 
                        SelectedItem="{Binding SelectedUserDefinedTarget}"/>
                    
                    <Label Grid.Row="3" Content="Select Data Set" Classes="OverviewHeaders"/>
                    <StackPanel Grid.Row="4" Orientation="Vertical">
                        <RadioButton Content="All Data" IsChecked="{Binding IsAllDataChecked}" GroupName="DataSet"/>
                        <RadioButton Content="Date Range" IsChecked="{Binding IsDateRangeChecked}" GroupName="DataSet"/>
                    </StackPanel>
                    
                    <Grid 
                        Grid.Row="6" 
                        RowDefinitions="Auto,Auto,Auto,10,Auto,Auto,Auto"
                        IsVisible="{Binding IsDateRangeChecked}">
                        <Label Grid.Row="0" Content="Select Starting Date and Time" Classes="OverviewHeaders"/>
                        <DatePicker Grid.Row="1" SelectedDate="{Binding StartDate}"/>
                        <TimePicker Grid.Row="2" SelectedTime="{Binding StartTime}"/>
                        
                        <Label Grid.Row="4" Content="Select Ending Date and Time" Classes="OverviewHeaders"/>
                        <DatePicker Grid.Row="5" SelectedDate="{Binding EndDate}"/>
                        <TimePicker Grid.Row="6" SelectedTime="{Binding EndTime}"/>
                    </Grid>
                </Grid>
                
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button
                        Classes="PrimaryButton" 
                        Width="120"
                        HorizontalAlignment="Center"
                        Margin="3,10,3,0"
                        Command="{Binding GenerateReportButtonCommand}">
                        <Label Content="Generate"/>
                    </Button>
                    
                    <Button
                        Classes="SecondaryButton" 
                        Width="120"
                        HorizontalAlignment="Center"
                        Margin="3,10,3,0"
                        Command="{Binding CancelNewReportButtonCommand}">
                        <Label Content="Cancel"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!--Top Control Bar-->
        <Border Grid.Row="0" Classes="ContentCard">
            <Grid ColumnDefinitions="100,100,*,220">
                <Button Grid.Column="0" Width="90" Command="{Binding NewReportButtonCommand}" Classes="PrimaryButton">
                    <Label Content="New"/>
                </Button>
                
                <Button Grid.Column="1" Width="90" Command="{Binding FetchAvailableSessionDataButtonCommand}" Classes="PrimaryButton">
                    <Label Content="Refresh"/>
                </Button>
            
                <Button Grid.Column="3" Width="210" Command="{Binding OpenReportsDirectoryButtonCommand}" Classes="SecondaryButton">
                    <Label Content="Open Reports Directory"/>
                </Button>
            </Grid>
        </Border>
        
        <!--Available Sessions Datagrid-->
        <Border Grid.Row="1" Classes="ContentCard">
            <Grid RowDefinitions="35,*">
                <Border Classes="ContentCardTitle">
                    <Label Content="Available Sessions"/>
                </Border>
                
                <DataGrid
                    Grid.Row="1"
                    ItemsSource="{Binding AvailableSessionData}"
                    SelectedItem="{Binding SelectedSessionData}"
                    Background="{DynamicResource SystemAltLowColor}"
                    GridLinesVisibility="Horizontal"
                    IsReadOnly="True"
                    SelectionMode="Extended"
                    VerticalScrollBarVisibility="Auto"
                    CanUserResizeColumns="True"
                    BorderThickness="0">
                    
                    <DataGrid.Styles>
                        <Style Selector="DataGridColumnHeader">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="{DynamicResource SystemAltLowColor}"/>
                            <Setter Property="AreSeparatorsVisible" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                                
                        <Style Selector="DataGridCell">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        
                        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                        
                        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                    </DataGrid.Styles>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="GUID" Binding="{Binding DisplayName}" Width="2*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Mode}" Width=".8*"/>
                        <DataGridTextColumn Header="Start Time" Binding="{Binding StartDateTime}" Width="*"/>
                        <DataGridTextColumn Header="End Time" Binding="{Binding EndDateTime}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
