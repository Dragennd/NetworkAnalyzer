<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NetworkAnalyzer.ViewModels"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="NetworkAnalyzer.Views.ReportsView"
    x:DataType="vm:ReportsViewModel"
    FontSize="16">
    
    <Grid RowDefinitions="70,*">
        <Border Grid.Row="0" Classes="ContentCard">
            
        </Border>
        
        <Border Grid.Row="1" Classes="ContentCard">
            <Border Classes="ContentCardTitle">
                <Label Content="Available Session Data"/>
            </Border>
        </Border>
    </Grid>
</UserControl>
