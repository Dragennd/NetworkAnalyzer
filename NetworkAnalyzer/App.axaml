<Application 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="NetworkAnalyzer.App"
    xmlns:vm="using:NetworkAnalyzer.ViewModels"
    x:DataType="vm:AppViewModel"
    RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#FF024B77" AltHigh="#fff3f2f5" AltLow="#fff3f2f5" AltMedium="#fff3f2f5" AltMediumHigh="#fff3f2f5" AltMediumLow="#fff3f2f5" BaseHigh="#fff3f2f5" BaseLow="WhiteSmoke" BaseMedium="DarkGray" BaseMediumHigh="#ff777777" BaseMediumLow="#ff909090" ChromeAltLow="#ff777777" ChromeBlackHigh="Black" ChromeBlackLow="WhiteSmoke" ChromeBlackMedium="#ff777777" ChromeBlackMediumLow="DarkGray" ChromeDisabledHigh="WhiteSmoke" ChromeDisabledLow="DarkGray" ChromeGray="#ff909090" ChromeHigh="WhiteSmoke" ChromeLow="#fffbfbfb" ChromeMedium="#fffafafa" ChromeMediumLow="#fffbfbfb" ChromeWhite="White" ListLow="#fffafafa" ListMedium="WhiteSmoke" RegionColor="White"/>
                <ColorPaletteResources x:Key="Dark" Accent="#FF024B77" AltHigh="#ff262626" AltLow="#ff1d1c1f" AltMedium="#ff262626" AltMediumHigh="#ff262626" AltMediumLow="#ff262626" BaseHigh="White" BaseLow="#ff262626" BaseMedium="#ff949494" BaseMediumHigh="#ffafafaf" BaseMediumLow="#ff50505c" ChromeAltLow="#ffafafaf" ChromeBlackHigh="#ff1d1c1f" ChromeBlackLow="#ffafafaf" ChromeBlackMedium="#ff1d1c1f" ChromeBlackMediumLow="#ff1d1c1f" ChromeDisabledHigh="#ff262626" ChromeDisabledLow="#ff949494" ChromeGray="#ff787878" ChromeHigh="#ff787878" ChromeLow="#ff101010" ChromeMedium="#ff151515" ChromeMediumLow="#ff202020" ChromeWhite="White" ListLow="#ff151515" ListMedium="#ff262626" RegionColor="#ff1a191c"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        
        <materialIcons:MaterialIconStyles/>
        
        <StyleInclude Source="Styles/CardTemplates.axaml"/>
        <StyleInclude Source="Styles/ButtonTemplates.axaml"/>
        <StyleInclude Source="Styles/RadioButtonTemplates.axaml"/>
        <StyleInclude Source="Styles/ComboBoxTemplates.axaml"/>
        <StyleInclude Source="Styles/LabelTemplates.axaml"/>
        <StyleInclude Source="Styles/TextBlockTemplates.axaml"/>
        <StyleInclude Source="Styles/GridSplitterTemplates.axaml"/>
    </Application.Styles>
    
    <Application.Resources>
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double> 
    </Application.Resources>
    
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="Images/icon.png" ToolTipText="Network Analyzer">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show Network Analyzer" Command="{Binding ToggleWindowCommand}"/>
                        <NativeMenuItem Header="Exit Network Analyzer" Command="{Binding CloseWindowCommand}"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>